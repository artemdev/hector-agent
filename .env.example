# Copy to .env and fill in. Never commit .env.

# Repo the agent fixes and opens PRs on (owner/name), and a token that can push and open PRs there
GIT_REPO_NAME=your-name/your-app
GIT_AUTH_TOKEN=

# Claude credentials for the agent: set one of the two
ANTHROPIC_API_KEY=
# from `claude setup-token`, to use a Claude subscription instead
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: Telegram status messages
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook (make serve)
ENV=dev
PORT=8000
SENTRY_CLIENT_SECRET=
# ENV=prod only: repo that runs .github/workflows/fix-issue.yml, and a token allowed to send repository_dispatch to it
WATCHDOG_REPO=your-name/watchdog-agent
DISPATCH_TOKEN=

# End-to-end tests: set to 1 to also run the LLM security judge
RUN_LLM_JUDGE=0
